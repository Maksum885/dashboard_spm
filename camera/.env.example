# CV Flask service — copy ke camera/.env dan sesuaikan
# ============================================================
# MODE PC BIASA (default):
#   CAMERA_INPUT_MODE=ffmpeg
#   YOLO_DEVICE=cpu
#   YOLO_HALF=false
#
# MODE JETSON NANO P3450 (JetPack 4.6, Python 3.8):
#   CAMERA_INPUT_MODE=gst_rtsp   → RTSP IP camera via GStreamer (Hikvision, dll)
#   CAMERA_INPUT_MODE=csi        → CSI camera langsung (IMX219)
#   CAMERA_INPUT_MODE=usb        → USB webcam
#   YOLO_DEVICE=cuda:0           → inferensi YOLO di GPU Jetson
#   YOLO_HALF=true               → FP16, lebih cepat di GPU Jetson
#
# PENTING untuk Jetson — tambahkan di ~/.bashrc DAN di unit systemd:
#   export OPENBLAS_CORETYPE=ARMV8
#   (tanpa ini, numpy crash saat import di Jetson ARM64)
#
# Versi library yang wajib:
#   pymodbus==2.5.3  (BUKAN >=3.0 — API berbeda total)
#   Python 3.8+ (dataclass butuh 3.7+; rekomendasikan 3.8 di Jetson)
# ============================================================

# ─── Server ───────────────────────────────────────────────────────────────────
CV_HOST=0.0.0.0
# Port 5001 sesuai setup Jetson Nano (port 5000 dipakai proses lain JetPack).
# Akses dari dashboard: http://192.168.1.200:5001  (wlan0 Jetson)
CV_PORT=5001

# ─── Laravel bridge ───────────────────────────────────────────────────────────
# Token harus sama dengan PLC_BRIDGE_TOKEN di Laravel .env
# Jetson Nano mengakses Laravel via wlan0. Ganti IP sesuai server Laravel Anda.
# Contoh: Jetson wlan0=192.168.1.200, Laravel di PC 192.168.1.10
LARAVEL_BRIDGE_CAMERAS_URL=http://192.168.1.10:8000/api/cv/bridge-cameras?token=your_32_char_bridge_token_here

# Seberapa sering reload daftar kamera dari Laravel (detik)
CV_MAP_REFRESH_SEC=15

# ─── YOLO / Deteksi Orang ─────────────────────────────────────────────────────
# YOLO_ENABLED=false → matikan inferensi YOLO, hemat CPU besar.
#   Stream kamera RTSP tetap jalan, hanya deteksi orang yang dinonaktifkan.
YOLO_ENABLED=true

# Path ke file model YOLO (.pt atau .engine untuk TensorRT).
# Kosongkan = pakai camera/models/yolov8n.pt
# Jetson TensorRT: ganti dengan path ke yolov8n.engine
YOLO_MODEL_PATH=

# Jalankan YOLO setiap N frame.
# PC: 5 | Jetson Nano dengan TensorRT: bisa 1 (setiap frame)
YOLO_DETECT_EVERY_N_FRAMES=5

# Perangkat inferensi YOLO:
#   cpu    → default (PC tanpa GPU)
#   cuda:0 → GPU Jetson Nano / NVIDIA GPU
YOLO_DEVICE=cpu

# FP16 half-precision — lebih cepat & hemat VRAM di Jetson Nano GPU.
# Hanya aktifkan jika YOLO_DEVICE=cuda:0
YOLO_HALF=false

# ─── Mode input kamera ────────────────────────────────────────────────────────
# ffmpeg    → RTSP via FFmpeg (default, untuk PC)
# gst_rtsp  → RTSP via GStreamer avdec_h264 software decoder (Jetson Nano + IP camera)
#             Direkomendasikan untuk Hikvision RTSP di Jetson (avdec_h264 lebih kompatibel).
#             URL kamera di database: rtsp://admin:pass@192.168.1.64:554/Streaming/Channels/102
#             (format Hikvision sub-stream; channel 102 = stream resolusi rendah 640×360)
# csi       → CSI camera Jetson Nano (nvarguscamerasrc), URL di DB: 'csi://0'
# usb       → USB camera via GStreamer v4l2, URL di DB: 'usb:///dev/video0'
CAMERA_INPUT_MODE=ffmpeg

# Resolusi dan FPS (berlaku untuk mode csi dan usb)
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=30

# ─── Stream encoding ──────────────────────────────────────────────────────────
# Kualitas JPEG stream (10–100). Turunkan untuk kurangi bandwidth & CPU encoding.
JPEG_QUALITY=70

# Transport RTSP: tcp (stabil) atau udp (latensi rendah)
RTSP_TRANSPORT=tcp

# Waktu tunggu sebelum reconnect saat gagal (detik)
RECONNECT_DELAY_SEC=2

# ─── Skema Hybrid: Tulis Hasil CV ke PLC (Modbus TCP FC6) ────────────────────
#
# Jika diaktifkan, Jetson menulis hasil deteksi orang ke holding register PLC.
# python-modbus kemudian membaca register %MW14 bersama register lain dan
# mengirimnya ke Laravel webhook → alarm CV masuk ke AlarmLog & dashboard.
#
# Jalur langsung /alarm_status → browser TETAP aktif bersamaan (skema hybrid).
# Butuh: pip install pymodbus==2.5.3  (BUKAN >=3.0 — API berbeda, tidak kompatibel)
#
# false (default) = hanya jalur langsung /alarm_status ke browser
# true            = Jetson juga menulis ke PLC register %MW14 via FC6
PLC_WRITE_ENABLED=false

# Port Modbus TCP (standar industri = 502)
PLC_MODBUS_PORT=502

# Unit ID PLC. Schneider M221 TM221CE24R = 1.
PLC_MODBUS_UNIT_ID=1

# Timeout koneksi Modbus (detik)
PLC_MODBUS_TIMEOUT=3.0

# PDU address (0-based) = "Holding Register 10" = %MW9 di Schneider M221 TM221CE24R.
# PDU 9 = Modbus address 40010 = register ke-10 (dari 40001).
# Nilai 1 → deteksi orang → PLC nyalakan aktuator lampu via %MW9.
# Nilai 0 → tidak ada orang → PLC matikan lampu.
CV_PLC_WRITE_ADDRESS=9

# IP PLC per ruangan — sesuaikan nomor dengan room_id di database Laravel.
# Kosongkan jika ruangan itu tidak punya PLC atau Jetson tidak perlu menulis ke sana.
# PLC_04_IP=192.168.1.4 adalah Schneider M221 TM221CE24R (sesuai dokumentasi setup).
PLC_01_IP=192.168.1.1
PLC_02_IP=192.168.1.2
PLC_03_IP=192.168.1.3
PLC_04_IP=192.168.1.4
PLC_05_IP=192.168.1.5
PLC_06_IP=192.168.1.6
PLC_07_IP=192.168.1.11
PLC_08_IP=192.168.1.12
PLC_09_IP=192.168.1.13
PLC_10_IP=192.168.1.14
PLC_11_IP=192.168.1.15
