# CV Flask service — copy to camera/.env and adjust

# Bind address (0.0.0.0 = all interfaces)
CV_HOST=0.0.0.0
CV_PORT=5000

# Laravel bridge — same token as PLC_BRIDGE_TOKEN in Laravel .env
LARAVEL_BRIDGE_CAMERAS_URL=http://127.0.0.1:8000/api/cv/bridge-cameras?token=your_32_char_bridge_token_here

# How often to reload enabled cameras from Laravel (seconds)
CV_MAP_REFRESH_SEC=15

# YOLO
YOLO_MODEL_PATH=
YOLO_DETECT_EVERY_N_FRAMES=5

# Stream encoding
JPEG_QUALITY=70
RTSP_TRANSPORT=tcp
RECONNECT_DELAY_SEC=2
